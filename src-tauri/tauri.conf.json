{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sightdeck",
  "version": "0.2.8",
  "identifier": "dev.matheus.sightdeck",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "sightdeck",
        "width": 1280,
        "height": 820,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://registry.npmjs.org https://api.github.com; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/matheusbbdutra/sightdeck/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwMkJCMUVCRUUyNDdEODYKUldTR2ZTVHU2N0VyUUVkUExNRXNDdTdqamx5NlI3RG1lcGQyRVRCL3R0dTlUNzdqd1kwbExiL0MK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "publisher": "Matheus Dutra",
    "copyright": "© 2026 Matheus Dutra (MIT)",
    "shortDescription": "Desktop client for the pi coding agent",
    "longDescription": "sightdeck is a desktop client for the pi coding agent: sessions grouped by project, live subagent runs, markdown transcripts with tool cards, model and thinking controls."
  }
}
